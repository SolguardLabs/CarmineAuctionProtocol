@external
@view
def table_size() -> uint256:
    return TABLE_SIZE

@internal
@view
def _coarse_discount_bps(_bucket: uint256) -> uint256:
    if _bucket == 0:
        return 0
    if _bucket <= 4:
        return 150
    if _bucket <= 8:
        return 300
    if _bucket <= 16:
        return 500
    if _bucket <= 32:
        return 800
    if _bucket <= 64:
        return 1_200
    return 1_800

@internal
@view
def _bucket_from_health(_health_ray: uint256) -> uint256:
    if _health_ray < RAY:
        return 64
    if _health_ray < RAY * 105 // 100:
        return 32
    if _health_ray < RAY * 115 // 100:
        return 16
    if _health_ray < RAY * 135 // 100:
        return 8
    if _health_ray < RAY * 175 // 100:
        return 4
    return 1

@external
@view
def coarse_discount_bps(_bucket: uint256) -> uint256:
    return self._coarse_discount_bps(_bucket)

@external
@view
def bucket_from_health(_health_ray: uint256) -> uint256:
    return self._bucket_from_health(_health_ray)

@external
@view
def weighted_discount_bps(_health_ray: uint256, _volatility_bps: uint256) -> uint256:
    bucket: uint256 = self._bucket_from_health(_health_ray)
    base: uint256 = self._coarse_discount_bps(bucket)
    add_on: uint256 = _volatility_bps // 20
    if base + add_on > 5_000:
        return 5_000
    return base + add_on

